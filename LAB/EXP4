
clc;
clear;
close all;

%% EXPERIMENT 4: COMPARATIVE ANALYSIS OF IIR FILTERS
% Butterworth, Chebyshev Type-I and Elliptic Low-Pass Filters

%% 1. INPUT PARAMETERS
Fs  = 1000;      % Sampling frequency (Hz)
Fp  = 100;       % Passband edge frequency (Hz)
Fst = 150;       % Stopband edge frequency (Hz)
Rp  = 1;         % Maximum passband ripple (dB)
Rs  = 40;        % Minimum stopband attenuation (dB)

% Normalized frequencies
Wp  = Fp/(Fs/2);
Wst = Fst/(Fs/2);

%% 2. CHEBYSHEV TYPE-I THEORETICAL ORDER

epsilon = sqrt(10^(Rp/10)-1);

N_formula = acosh(sqrt((10^(Rs/10)-1) / ...
             (10^(Rp/10)-1))) / acosh(Fst/Fp);

N_theory = ceil(N_formula);

%% 3. BUTTERWORTH FILTER DESIGN

[Nb, Wb] = buttord(Wp, Wst, Rp, Rs);
[bB, aB] = butter(Nb, Wb, 'low');

%% 4. CHEBYSHEV TYPE-I FILTER DESIGN

[Nc, Wc] = cheb1ord(Wp, Wst, Rp, Rs);
[bC, aC] = cheby1(Nc, Rp, Wc, 'low');

%% 5. ELLIPTIC FILTER DESIGN

[Ne, We] = ellipord(Wp, Wst, Rp, Rs);
[bE, aE] = ellip(Ne, Rp, Rs, We, 'low');

%% 6. DISPLAY INPUT PARAMETERS

fprintf('\n============================================\n');
fprintf('       IIR FILTER COMPARATIVE ANALYSIS\n');
fprintf('============================================\n');

fprintf('\nINPUT PARAMETERS\n');
fprintf('Sampling Frequency      = %.2f Hz\n', Fs);
fprintf('Passband Edge           = %.2f Hz\n', Fp);
fprintf('Stopband Edge           = %.2f Hz\n', Fst);
fprintf('Passband Ripple         = %.2f dB\n', Rp);
fprintf('Stopband Attenuation    = %.2f dB\n', Rs);

%% 7. CHEBYSHEV FORMULA RESULTS

fprintf('\nCHEBYSHEV TYPE-I FORMULA\n');
fprintf('Ripple factor epsilon   = %.6f\n', epsilon);
fprintf('Calculated order        = %.6f\n', N_formula);
fprintf('Theoretical minimum N   = %d\n', N_theory);

%% 8. FILTER ORDER COMPARISON

fprintf('\nFILTER ORDER COMPARISON\n');
fprintf('Butterworth Order       = %d\n', Nb);
fprintf('Chebyshev Type-I Order  = %d\n', Nc);
fprintf('Elliptic Order          = %d\n', Ne);

%% 9. DISPLAY FILTER COEFFICIENTS

fprintf('\nBUTTERWORTH COEFFICIENTS\n');
fprintf('Numerator bB:\n');
disp(bB);
fprintf('Denominator aB:\n');
disp(aB);

fprintf('\nCHEBYSHEV TYPE-I COEFFICIENTS\n');
fprintf('Numerator bC:\n');
disp(bC);
fprintf('Denominator aC:\n');
disp(aC);

fprintf('\nELLIPTIC COEFFICIENTS\n');
fprintf('Numerator bE:\n');
disp(bE);
fprintf('Denominator aE:\n');
disp(aE);

%% 10. FREQUENCY RESPONSE CALCULATION

N = 16384;

[HB, f] = freqz(bB, aB, N, Fs);
[HC, ~] = freqz(bC, aC, N, Fs);
[HE, ~] = freqz(bE, aE, N, Fs);

% Magnitude response in dB
MB = 20*log10(max(abs(HB), 1e-12));
MC = 20*log10(max(abs(HC), 1e-12));
ME = 20*log10(max(abs(HE), 1e-12));

%% 11. PASSBAND RIPPLE MEASUREMENT

P = (f <= Fp);

Ripple_B = max(MB(P)) - min(MB(P));
Ripple_C = max(MC(P)) - min(MC(P));
Ripple_E = max(ME(P)) - min(ME(P));

%% 12. STOPBAND ATTENUATION MEASUREMENT

S = (f >= Fst);

Stop_B = -max(MB(S));
Stop_C = -max(MC(S));
Stop_E = -max(ME(S));

%% 13. PERFORMANCE DEVIATION

Dev_C_Ripple = abs(Ripple_C - Rp)/Rp * 100;

Dev_B_Stop = abs(Stop_B - Rs)/Rs * 100;
Dev_C_Stop = abs(Stop_C - Rs)/Rs * 100;
Dev_E_Stop = abs(Stop_E - Rs)/Rs * 100;

%% 14. TRANSITION BANDWIDTH

TransitionBW = Fst - Fp;

%% 15. DISPLAY PERFORMANCE RESULTS

fprintf('\n============================================\n');
fprintf('             FILTER PERFORMANCE\n');
fprintf('============================================\n');

fprintf('\nPASSBAND RIPPLE (dB)\n');
fprintf('Butterworth      = %.4f\n', Ripple_B);
fprintf('Chebyshev Type-I = %.4f\n', Ripple_C);
fprintf('Elliptic         = %.4f\n', Ripple_E);

fprintf('\nSTOPBAND ATTENUATION (dB)\n');
fprintf('Butterworth      = %.4f\n', Stop_B);
fprintf('Chebyshev Type-I = %.4f\n', Stop_C);
fprintf('Elliptic         = %.4f\n', Stop_E);

fprintf('\nCHEBYSHEV RIPPLE DEVIATION\n');
fprintf('Specified Ripple = %.2f dB\n', Rp);
fprintf('Measured Ripple  = %.4f dB\n', Ripple_C);
fprintf('Percentage Deviation = %.4f %%\n', Dev_C_Ripple);

fprintf('\nSTOPBAND ATTENUATION DEVIATION\n');
fprintf('Butterworth      = %.4f %%\n', Dev_B_Stop);
fprintf('Chebyshev Type-I = %.4f %%\n', Dev_C_Stop);
fprintf('Elliptic         = %.4f %%\n', Dev_E_Stop);

fprintf('\nTRANSITION CHARACTERISTICS\n');
fprintf('Passband Edge    = %.2f Hz\n', Fp);
fprintf('Stopband Edge    = %.2f Hz\n', Fst);
fprintf('Transition Band  = %.2f Hz\n', TransitionBW);

%% 16. MAGNITUDE RESPONSE COMPARISON

figure('Name', 'Magnitude Response Comparison', ...
       'NumberTitle', 'off');

plot(f, MB, 'LineWidth', 1.5);
hold on;
plot(f, MC, 'LineWidth', 1.5);
plot(f, ME, 'LineWidth', 1.5);

grid on;
xlabel('Frequency (Hz)');
ylabel('Magnitude (dB)');
title('Comparison of IIR Filter Magnitude Responses');

legend('Butterworth', 'Chebyshev Type-I', 'Elliptic', ...
       'Location', 'best');

xlim([0 250]);
ylim([-80 5]);

xline(Fp, '--k', 'Fp = 100 Hz');
xline(Fst, '--m', 'Fst = 150 Hz');
yline(-Rp, ':k', 'Rp = -1 dB');
yline(-Rs, ':r', 'Rs = -40 dB');

hold off;

%% 17. PHASE RESPONSE COMPARISON

Phase_B = unwrap(angle(HB))*180/pi;
Phase_C = unwrap(angle(HC))*180/pi;
Phase_E = unwrap(angle(HE))*180/pi;

figure('Name', 'Phase Response Comparison', ...
       'NumberTitle', 'off');

plot(f, Phase_B, 'LineWidth', 1.2);
hold on;
plot(f, Phase_C, 'LineWidth', 1.2);
plot(f, Phase_E, 'LineWidth', 1.2);

grid on;
xlabel('Frequency (Hz)');
ylabel('Phase (degrees)');
title('Comparison of IIR Filter Phase Responses');

legend('Butterworth', 'Chebyshev Type-I', 'Elliptic', ...
       'Location', 'best');

xlim([0 250]);
hold off;

%% 18. FILTER ORDER COMPARISON

figure('Name', 'Filter Order Comparison', ...
       'NumberTitle', 'off');

bar([Nb, Nc, Ne]);

set(gca, 'XTick', 1:3);
set(gca, 'XTickLabel', ...
    {'Butterworth', 'Chebyshev-I', 'Elliptic'});

ylabel('Filter Order');
xlabel('Filter Type');
title('Comparison of IIR Filter Orders');
grid on;

%% 19. FINAL RESULT

fprintf('\n============================================\n');
fprintf('Experiment completed successfully.\n');
fprintf('All three IIR filters designed and compared.\n');
fprintf('============================================\n');
