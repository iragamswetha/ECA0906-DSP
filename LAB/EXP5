clc;
clear;
close all;

%% IIR FILTER COEFFICIENTS
b = [0.0048 0.0193 0.0289 0.0193 0.0048];
a = [1 -2.3695 2.3140 -1.0547 0.1874];

N = 50;
x = [1 zeros(1, N-1)];     % Unit impulse input
n = 0:N-1;

%% 1. DIRECT FORM-I
y1 = filter(b, a, x);

%% 2. DIRECT FORM-II TRANSPOSED
% MATLAB filter uses a Direct Form-II Transposed implementation.
y2 = filter(b, a, x);

%% 3. CASCADE REALIZATION
[sos, g] = tf2sos(b, a);

yc = g * x;

for k = 1:size(sos, 1)
    yc = filter(sos(k, 1:3), sos(k, 4:6), yc);
end

%% 4. PARALLEL REALIZATION
[r, p, k] = residuez(b, a);

% Direct polynomial term
yp = filter(k, 1, x);

% Add first-order partial fractions
for i = 1:length(r)
    yp = yp + filter(r(i), [1 -p(i)], x);
end

%% 5. DISPLAY COEFFICIENTS
disp('Numerator coefficients b =');
disp(b);

disp('Denominator coefficients a =');
disp(a);

disp('Second Order Sections (Cascade) =');
disp(sos);

disp('Cascade Gain =');
disp(g);

disp('Residues (Parallel) =');
disp(r);

disp('Poles (Parallel) =');
disp(p);

disp('Direct term =');
disp(k);

%% 6. ERROR AND PERCENTAGE DEVIATION
E = [max(abs(y1-y2)), ...
     max(abs(y1-yc)), ...
     max(abs(y1-yp))];

peak = max(abs(y1));

if peak > 0
    D = E / peak * 100;
else
    D = zeros(size(E));
end

Structure = ["DF-I"; "DF-II"; "Cascade"; "Parallel"];

Maximum_Error = [0; E(:)];
Deviation_percent = [0; D(:)];

T = table(Structure, Maximum_Error, Deviation_percent);

disp('Comparison Table:');
disp(T);

%% 7. IMPULSE RESPONSE COMPARISON
figure('Name', 'Impulse Response Comparison');

stem(n, y1, 'filled');
hold on;
stem(n, y2, '--');
stem(n, yc, ':', 'LineWidth', 1.5);
stem(n, yp, '-.');

grid on;
xlabel('Sample index (n)');
ylabel('Amplitude');
title('Impulse Response of IIR Realizations');

legend('Direct Form-I', 'Direct Form-II', ...
       'Cascade', 'Parallel', 'Location', 'best');

hold off;

%% 8. NUMERICAL ERROR PLOT
figure('Name', 'Numerical Error');

plot(n, abs(y1-y2), '--', 'LineWidth', 1.2);
hold on;
plot(n, abs(y1-yc), ':', 'LineWidth', 1.5);
plot(n, abs(y1-yp), '-.', 'LineWidth', 1.2);

grid on;
xlabel('Sample index (n)');
ylabel('Absolute Error');
title('Numerical Error Between Realizations');

legend('DF-I vs DF-II', 'DF-I vs Cascade', ...
       'DF-I vs Parallel', 'Location', 'best');

hold off;

%% 9. FREQUENCY RESPONSE
figure('Name', 'IIR Frequency Response');

freqz(b, a, 1024);
title('Frequency Response of IIR Filter');

%% 10. POLE-ZERO PLOT
figure('Name', 'Pole-Zero Plot');

zplane(b, a);
title('Pole-Zero Plot of IIR Filter');

%% 11. FINAL RESULT
fprintf('\nIIR filter realization comparison completed.\n');
fprintf('Impulse response, numerical error, frequency response,');
fprintf(' and pole-zero plots generated.\n');
